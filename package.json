{
  "name": "studio-haus",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "start": "next start",
    "analyze": "node scripts/analyze-bundle.js",
    "lighthouse": "npx lighthouse http://localhost:3000 --output html --output-path ./lighthouse-report.html",
    "bundle:config": "node scripts/analyze-bundle.js --config",
    "optimize": "npm run build:analyze && npm run analyze",
    "performance": "node scripts/measure-performance.js",
    "perf": "npm run build && npm run performance"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "lucide-react": "^0.344.0",
    "next": "^14.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-window": "^1.8.11",
    "web-vitals": "^5.0.3"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.3.5",
    "@types/node": "22.15.2",
    "@types/react": "19.1.2",
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "5.8.3"
  }
}
